#!/bin/bash
#
# Date    : 11 November 2026
# Purpose : Install EmComm Tools into the image (live-build chroot hook).
#
# Runs install.sh (build mode) from the repository copy build.sh puts in
# /opt/emcomm-tools-os-community, then leaves that copy read-only. Numbered
# 0900 to run before live-build's cleanup hooks (8000-8110).

set -u

BUILD_DIR=/opt/emcomm-tools-os-community
LOG=/tmp/et/et.log

cd "${BUILD_DIR}/scripts" || exit 1
export ET_BUILD=1

./install.sh
RC=$?

echo "=== EmComm Tools build: install.sh exit code ${RC} ==="
if [[ -f "${LOG}" ]]; then
  FAILED=$(grep -c 'failed with exit code' "${LOG}" || true)
  echo "=== Failed steps: ${FAILED} ==="
  grep 'failed with exit code' "${LOG}" || true
fi

# Live installer launcher: ETC's name and logo instead of Debian's.
sed -i -e 's/^Name=.*/Name=Install EmComm Tools/' \
  -e 's|^Icon=.*|Icon=/etc/calamares/branding/emcomm-tools/logo.png|' \
  /usr/share/applications/install-debian.desktop

# Live session dock: Debian's live settings replace ETC's dock; use the
# installer plus ETC's launchers.
SCHEMAS=/usr/share/glib-2.0/schemas
ETC_FAV=$(sed -n 's/^favorite-apps *= *\[\(.*\)\]/\1/p' "${SCHEMAS}/90_emcomm-tools.gschema.override")
if [[ -n "${ETC_FAV}" && -f "${SCHEMAS}/96_calamares-settings-debian.gschema.override" ]]; then
  sed -i "s|^favorite-apps=.*|favorite-apps=['install-debian.desktop', ${ETC_FAV}]|" \
    "${SCHEMAS}/96_calamares-settings-debian.gschema.override"
  glib-compile-schemas "${SCHEMAS}"
fi

# Keep the repository as a read-only copy: drop what the build added to it
# and the git history.
git -c safe.directory='*' -C "${BUILD_DIR}" clean -fdxq
rm -rf "${BUILD_DIR}/.git"
chown -R root:root "${BUILD_DIR}"
chmod -R u+rwX,go+rX,go-w "${BUILD_DIR}"
# Not executable, so install.sh isn't run over an installed system by accident.
chmod a-x "${BUILD_DIR}/scripts/install.sh"

# Nothing else from the build stays in the image.
rm -rf /tmp/et /opt/dist /opt/src 2>/dev/null
apt-get clean

exit 0
