#!/bin/bash
#
# Date    : 11 November 2026
# Purpose : Install EmComm Tools into the image (live-build chroot hook).
#
# build.sh copies the repository to /root/etc-build (config/includes.chroot).
# This runs install.sh in build mode (no prompts), reports failed steps, keeps
# a read-only copy at /opt/emcomm-tools-os-community, and removes the build
# copy and the logs.
#
# Numbered 0900 so it runs before live-build's cleanup hooks (8000-8110), which
# then remove logs, SSH host keys, machine-id and temporary files from the image.

set -u

BUILD_DIR=/root/etc-build
LOG=/tmp/et/et.log

cd "${BUILD_DIR}/scripts" || exit 1
export ET_BUILD=1
[[ -n "${ET_RELEASE:-}" ]] && export ET_RELEASE

./install.sh
RC=$?

# et-api's NWS forecast zone data. et-api 1.3.0 reads it from
# data/weather-forecast-zone.csv, but neither its release nor ETC provides it:
# without it et-api fails at first start, and with a GPS connected the failed
# process hangs instead of restarting. It's the National Weather Service's
# zone-county correlation file (public domain, https://www.weather.gov/gis/ZoneCounty).
# Staged here, for the ISO only, so et-api's install and config stay as in r7.
NWS_URL="https://www.weather.gov/source/gis/Shapefiles/County/bp16ap26.dbx"
NWS_SHA256="69d3472d4d576b8a4924efb7a43108f7c64111f503e15efd650f43dc617a6f12"
NWS_FILE=/opt/emcomm-tools-api/data/weather-forecast-zone.csv
if curl -L -f -s --retry 3 -o "${NWS_FILE}" "${NWS_URL}" \
   && echo "${NWS_SHA256}  ${NWS_FILE}" | sha256sum -c --quiet -; then
  chgrp et-data "${NWS_FILE}" && chmod 664 "${NWS_FILE}"
  echo "et-api forecast zone data: ${NWS_FILE}"
else
  rm -f "${NWS_FILE}"
  echo "\"download ${NWS_URL}\" command failed with exit code 1." >> "${LOG}"
fi

echo "=== EmComm Tools build: install.sh exit code ${RC} ==="
if [[ -f "${LOG}" ]]; then
  FAILED=$(grep -c 'failed with exit code' "${LOG}" || true)
  echo "=== Failed steps: ${FAILED} ==="
  grep 'failed with exit code' "${LOG}" || true
fi

# Live installer launcher: ETC's name instead of "Install Debian".
sed -i 's/^Name=.*/Name=Install EmComm Tools/' /usr/share/applications/install-debian.desktop

# Live session dock: Debian's live settings (96_calamares-settings-debian,
# removed with Calamares at install) override ETC's dock with Debian's apps.
# Use the installer plus ETC's launchers instead.
SCHEMAS=/usr/share/glib-2.0/schemas
ETC_FAV=$(sed -n 's/^favorite-apps *= *\[\(.*\)\]/\1/p' "${SCHEMAS}/90_emcomm-tools.gschema.override")
if [[ -n "${ETC_FAV}" && -f "${SCHEMAS}/96_calamares-settings-debian.gschema.override" ]]; then
  sed -i "s|^favorite-apps=.*|favorite-apps=['install-debian.desktop', ${ETC_FAV}]|" \
    "${SCHEMAS}/96_calamares-settings-debian.gschema.override"
  glib-compile-schemas "${SCHEMAS}"
fi

# A read-only copy of the repository the ISO was built from (tracked files, no
# git history), for scripts users run after install: maps, Wikipedia, xara,
# the test suite. See docs/INSTALL-GUIDE.md.
REPO_COPY=/opt/emcomm-tools-os-community
rm -rf "${REPO_COPY}" && mkdir -p "${REPO_COPY}"
(cd "${BUILD_DIR}" && git -c safe.directory='*' ls-files -z \
  | xargs -0 cp --parents -t "${REPO_COPY}")
chown -R root:root "${REPO_COPY}"
chmod -R u+rwX,go+rX,go-w "${REPO_COPY}"

# Nothing else from the build stays in the image.
rm -rf "${BUILD_DIR}" /tmp/et /opt/dist /opt/src 2>/dev/null
apt-get clean

exit 0
